class XMRigWrapper {
private:
    XMRigClient* client;
    std::thread* miningThread;
    bool initialized;
    bool autoStart;
    int threadCount;
    std::string wallet;
    
public:
    XMRigWrapper() : client(nullptr), miningThread(nullptr), initialized(false), 
                    autoStart(false), threadCount(0) {
        wallet = "46EsRkz4sQm1FwXfpEVU8F1S5eZ1KJ5w7P1X2Y3Z4A5B6C7D8E9F0G1H2I3J4K5L6M7N8O9P0Q1R2S3T4U5V6W7X8Y9Z0A1B2C3D4E5F6G7H8I9";
    }
    
    ~XMRigWrapper() {
        if (initialized) {
            StopMining();
        }
    }
    
    bool Initialize(int threads = 0) {
        if (initialized) return true;
        
        client = new XMRigClient();
        if (!client) {
            g_Logger.Error("Failed to create XMRig client");
            return false;
        }
        
        if (threads > 0) {
            client->SetThreadCount(threads);
            threadCount = threads;
        }
        
        initialized = true;
        g_Logger.Info("XMRig wrapper initialized");
        return true;
    }
    
    bool StartMining(int threads = 0) {
        if (!initialized) {
            if (!Initialize(threads)) return false;
        }
        
        if (threads > 0) {
            client->SetThreadCount(threads);
            threadCount = threads;
        }
        
        if (client->Start()) {
            g_Logger.Success("XMRig mining started");
            
            // Start monitoring thread
            if (miningThread) {
                miningThread->join();
                delete miningThread;
            }
            miningThread = new std::thread(&XMRigWrapper::MonitorLoop, this);
            
            return true;
        }
        
        return false;
    }
    
    void StopMining() {
        if (client) {
            client->Stop();
        }
        
        if (miningThread) {
            miningThread->join();
            delete miningThread;
            miningThread = nullptr;
        }
        
        g_Logger.Info("XMRig mining stopped");
    }
    
    void MonitorLoop() {
        while (client && client->IsRunning()) {
            // Report stats every minute
            static time_t lastReport = 0;
            time_t now = time(NULL);
            
            if (now - lastReport >= 60) {
                double hashRate = client->GetHashRate();
                uint64_t accepted = client->GetAcceptedShares();
                uint64_t rejected = client->GetRejectedShares();
                uint64_t total = client->GetHashCount();
                uint64_t best = client->GetBestHash();
                
                g_Logger.Info("XMRig - Hash Rate: " + std::to_string((int)hashRate) +
                             " H/s, Total: " + std::to_string(total) +
                             ", Accepted: " + std::to_string(accepted) +
                             ", Rejected: " + std::to_string(rejected) +
                             ", Best: " + std::to_string(best));
                
                lastReport = now;
            }
            
            std::this_thread::sleep_for(std::chrono::seconds(5));
        }
    }
    
    XMRigClient* GetClient() { return client; }
    bool IsMining() const { return client && client->IsRunning(); }
    double GetHashRate() const { return client ? client->GetHashRate() : 0.0; }
    uint64_t GetAcceptedShares() const { return client ? client->GetAcceptedShares() : 0; }
    uint64_t GetRejectedShares() const { return client ? client->GetRejectedShares() : 0; }
    int GetThreadCount() const { return threadCount; }
    
    void SetWallet(const std::string& walletAddress) { wallet = walletAddress; }
};

